import math

print("=== KALKULATOR SEDERHANA ===")
print("1. Tambah (+)")
print("2. Kurang (-)")
print("3. Kali (*)")
print("4. Bagi (/)")
print("5. Sin")
print("6. Cos")
print("7. Tan")

pilihan = input("\nPilih menu (1-7): ")

if pilihan in ["1", "2", "3", "4"]:
  angka1 = float(input("Masukkan angka pertama: "))
  angka2 = float(input("Masukkan angka kedua: "))

  if pilihan == "1":
    print("Hasil:", angka1 + angka2)
  elif pilihan == "2":
    print("Hasil:", angka1 - angka2)
  elif pilihan == "3":
    print("Hasil:", angka1 * angka2)
  elif pilihan == "4":
    if angka2 == 0:
      print("Error: Tidak bisa dibagi 0")
    else:
      print("Hasil:", angka1 / angka2)


elif pilihan in ["5", "6", "7"]:
  sudut = float(input("Masukkan sudut (derajat): "))
  radian = math.radians(sudut)  # Ubah derajat ke radian

  if pilihan == "5":
    print("Hasil:", round(math.sin(radian), 6))
  elif pilihan == "6":
    print("Hasil:", round(math.cos(radian), 6))
  elif pilihan == "7":
    if sudut % 180 == 90:
      print("Hasil: Tak terhingga")
    else:
      print("Hasil:", round(math.tan(radian), 6))

else:
  print("Pilihan tidak valid!")
